# Copy to deployment/local/.env.rahma-full (gitignored) — never commit real secrets.
RAHMA_POSTGRES_PASSWORD=rahma_local_dev_only
SESSION_SECRET=change_me_use_at_least_32_random_chars_abc123XYZ
FCM_SERVER_KEY=change_me_fcm_server_key_min_20_chars_xx
APNS_P8_KEY=change_me_apns_p8_key_min_20_chars_xxxx
APP_STORE_COMPLIANCE_STATUS=approved
AUTH_MODE=external
PUSH_NOTIFICATIONS_PRODUCTION_REQUIRED=true
IOS_PUSH_REQUIRED=true
RAG_VECTOR_SEARCH=true
WASM_RUNTIME_MODE=required
# API container: mount repo paths and set RAHMA_REPO_ROOT=/app (see docker-compose.rahma-full.yml)
