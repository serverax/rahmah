# Rahma/Sakina — example environment.
# Copy to .env (gitignored). Never commit real secrets.

# Backend
NODE_ENV=development
PORT=18080
HOST=127.0.0.1
API_SCOPE=ibadat

# Database — use pgvector stack (see deployment/local/docker-compose.rahma-stack.yml)
# Local pgvector: postgresql://rahma_user:YOUR_PASSWORD@127.0.0.1:5435/rahma
DATABASE_URL=postgres://rahma_user:CHANGE_ME@127.0.0.1:5435/rahma

# Redis — required for production_ready when all gates enabled
# Local stack: redis://127.0.0.1:6381/0
REDIS_URL=redis://127.0.0.1:6381/0

# Auth (production_ready requires configured auth)
# Modes: not_configured | dev_local | external
AUTH_MODE=external
SESSION_SECRET=CHANGE_ME_use_at_least_32_random_characters_here
# SAKINA_ALLOW_DEV_AUTH=true
# AUTH_SHEIKH_LOGIN=true

# WASM — production default is required (live bridges + /evaluate proof)
# WASM_RUNTIME_MODE=disabled
# WASM_DISABLE_APPROVED=true
WASM_RUNTIME_MODE=required
# WASM_FATWA_POLICY_GATE_URL=http://127.0.0.1:8091
# WASM_QURAN_HADITH_CITATION_URL=http://127.0.0.1:8092
# WASM_CHILD_SAFETY_URL=http://127.0.0.1:8093
# WASM_CONTENT_RULE_ENGINE_URL=http://127.0.0.1:8094

# RAG
RAG_VECTOR_SEARCH=true

# App-store compliance gate (approved | pending | blocked)
APP_STORE_COMPLIANCE_STATUS=pending

# Push notifications (production_ready requires both when PUSH_NOTIFICATIONS_PRODUCTION_REQUIRED=true)
# PUSH_NOTIFICATIONS_PRODUCTION_REQUIRED=true
# IOS_PUSH_REQUIRED=true
# FCM_SERVER_KEY=
# APNS_P8_KEY=

# Local LLM (foundation)
LOCAL_LLM_ENABLED=true

# Sheikh / WhatsApp (disabled by default)
SHEIKH_AUTH_REQUIRED=false
WHATSAPP_ENABLED=false

# Charity payments (disabled by default)
DONATION_PROVIDER=manual_offline
