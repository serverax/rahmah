# Rahma/Sakina — example environment.
# Copy to .env (gitignored). Never commit real secrets.

# Backend
NODE_ENV=development
PORT=3000
API_SCOPE=ibadat

# Database (rotate password before use)
DATABASE_URL=postgres://rahma_user:CHANGE_ME@127.0.0.1:5433/rahma

# Redis (no adapter shipped yet — set this only to test /ready.cache.redis_url_configured=true)
# REDIS_URL=redis://127.0.0.1:6379

# Auth / Sheikh
SHEIKH_AUTH_REQUIRED=false
AUTH_STATUS=not_configured

# WhatsApp (disabled by default)
WHATSAPP_ENABLED=false
# WHATSAPP_PROVIDER=meta-cloud
# WHATSAPP_API_TOKEN=CHANGE_ME
# SHEIKH_HASAN_WHATSAPP_TO=CHANGE_ME

# Charity payments (disabled by default)
CHARITY_PAYMENT_PROVIDER_STATUS=disabled

# App-store compliance mode
APP_STORE_COMPLIANCE_MODE=true
