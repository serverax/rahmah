{
  "name": "rahma-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Rahma Islamic App Monorepo Root",
  "type": "module",
  "scripts": {
    "test": "npm run test:backend && npm run test:mobile",
    "test:backend": "cd backend/app && npm test",
    "test:mobile": "cd apps/mobile && flutter test",
    "lint": "npm run lint:backend",
    "lint:backend": "cd backend/app && npm run lint",
    "typecheck": "node --check backend/app/src/index.js && node --check backend/app/src/app.js && node --check backend/app/src/routes/ready.js && node --check backend/app/src/rag/local-llm/client.js",
    "db:verify": "node scripts/db/verify-rahma-schema.js",
    "db:verify:complete": "node scripts/db/verify-complete-schema.js",
    "verify": "npm run lint && npm run test:backend && npm run db:verify",
    "local:test-ui": "node scripts/start-rahma-test-ui.js",
    "local:test-ui:check": "node scripts/check-rahma-test-ui.js",
    "test:local-test-ui": "node scripts/smoke-rahma-test-ui.js",
    "backend:dev": "cd backend/app && npm run dev",
    "mobile:web": "cd apps/mobile && flutter run -d chrome"
  }
}
